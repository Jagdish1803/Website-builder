{"id":"1b393482","type":"cta","label":"Money-back guarantee promise","html":"<section class=\"cmp cmp-cta section\">\n  <div class=\"container\">\n    <div class=\"cmp-cta__box\">\n      <div class=\"cmp-cta__seal\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 120 120\" width=\"120\" height=\"120\">\n          <defs><path id=\"cmpCtaCircle\" d=\"M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0\"/></defs>\n          <text font-size=\"10.5\" letter-spacing=\"3\" fill=\"currentColor\"><textPath href=\"#cmpCtaCircle\">100% MONEY-BACK · GUARANTEE · </textPath></text>\n          <text x=\"60\" y=\"70\" text-anchor=\"middle\" font-size=\"30\" font-weight=\"700\" fill=\"currentColor\">✳</text>\n        </svg>\n      </div>\n      <div class=\"cmp-cta__copy\">\n        <p class=\"eyebrow\">Our promise</p>\n        <h3 class=\"h2\">100% money-back guarantee</h3>\n        <p class=\"lead\">If you are not satisfied with the work we deliver, you get your money back — no arguments, no paperwork. We would rather refund you than hand over something you are not happy to launch.</p>\n      </div>\n      <a class=\"btn cmp-cta__btn\" href=\"#contact\">Start a Project →</a>\n    </div>\n  </div>\n  <style>\n    .cmp-cta .cmp-cta__box{display:grid;grid-template-columns:auto 1fr auto;gap:clamp(24px,4vw,48px);align-items:center;padding:clamp(32px,5vw,64px);border-radius:var(--radius);background:var(--accent);color:var(--accent-contrast);position:relative;overflow:hidden}\n    .cmp-cta .cmp-cta__box::after{content:\"\";position:absolute;right:-120px;bottom:-160px;width:420px;height:420px;border-radius:50%;border:1px solid color-mix(in srgb,var(--accent-contrast) 25%,transparent);pointer-events:none}\n    .cmp-cta .cmp-cta__seal{color:var(--accent-contrast)}\n    .cmp-cta .cmp-cta__seal svg{animation:cmpCtaSpin 24s linear infinite;display:block}\n    .cmp-cta .eyebrow,.cmp-cta .lead{color:var(--accent-contrast);opacity:.88}\n    .cmp-cta .h2{margin:6px 0 12px;color:var(--accent-contrast)}\n    .cmp-cta .lead{margin:0;max-width:60ch}\n    .cmp-cta .cmp-cta__btn{background:var(--accent-contrast);color:var(--accent);border-color:var(--accent-contrast);white-space:nowrap;position:relative;z-index:1}\n    @keyframes cmpCtaSpin{to{transform:rotate(360deg)}}\n    @media (max-width:860px){.cmp-cta .cmp-cta__box{grid-template-columns:1fr}.cmp-cta .cmp-cta__btn{justify-self:start}}\n    @media (prefers-reduced-motion:reduce){.cmp-cta .cmp-cta__seal svg{animation:none}}\n  </style>\n</section>","sourceUrl":"https://logicloomweb.com/","createdAt":"2026-10-17T07:15:21.668Z"}