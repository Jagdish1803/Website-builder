{"id":"411afda8","type":"hero","label":"Hero with living room image","html":"<section class=\"cmp cmp-hero section\" id=\"main\">\n  <div class=\"container\">\n    <div class=\"cmp-hero__frame\">\n      <img class=\"cmp-hero__img\" src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fsite%2Fhero-living.jpg&w=3840&q=75\" alt=\"A warm, modern living room designed by our studio\">\n      <div class=\"cmp-hero__shade\" aria-hidden=\"true\"></div>\n      <div class=\"cmp-hero__content\">\n        <p class=\"eyebrow\">Interiors for homes, offices &amp; commercial spaces</p>\n        <h1 class=\"h1\">Homes that feel <em>entirely yours</em></h1>\n        <p class=\"lead\">Thoughtful design, honest pricing and expert installation from one team, for homes, offices and commercial spaces.</p>\n        <div class=\"cmp-hero__ctas\">\n          <a class=\"btn accent\" href=\"/contact\">Book a consultation</a>\n          <a class=\"btn cmp-hero__ghost\" href=\"/designs\">Explore designs</a>\n        </div>\n      </div>\n      <p class=\"cmp-hero__scroll\" aria-hidden=\"true\"><span></span>Scroll down</p>\n    </div>\n  </div>\n  <style>\n    .cmp-hero .cmp-hero__frame{position:relative;border-radius:var(--radius);overflow:hidden;min-height:min(86vh,780px);display:flex;align-items:flex-end;isolation:isolate}\n    .cmp-hero .cmp-hero__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;animation:cmpHeroZoom 14s ease-out both}\n    .cmp-hero .cmp-hero__shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,0,0,.05) 20%,rgba(0,0,0,.65) 100%)}\n    .cmp-hero .cmp-hero__content{padding:clamp(1.5rem,5vw,4rem);max-width:760px;color:#fff}\n    .cmp-hero .eyebrow{color:rgba(255,255,255,.82)}\n    .cmp-hero .h1{color:#fff;margin:.5rem 0 1rem;line-height:1.02}\n    .cmp-hero .h1 em{font-style:italic;font-weight:400;font-family:Georgia,\"Times New Roman\",serif}\n    .cmp-hero .lead{color:rgba(255,255,255,.88);max-width:540px}\n    .cmp-hero .cmp-hero__ctas{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.75rem}\n    .cmp-hero .cmp-hero__ghost{background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.45);backdrop-filter:blur(6px)}\n    .cmp-hero .cmp-hero__ghost:hover{background:rgba(255,255,255,.22)}\n    .cmp-hero .cmp-hero__scroll{position:absolute;right:clamp(1.25rem,3vw,2.5rem);bottom:clamp(1.25rem,3vw,2.5rem);color:rgba(255,255,255,.8);font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;display:flex;align-items:center;gap:.6rem;writing-mode:vertical-rl;margin:0}\n    .cmp-hero .cmp-hero__scroll span{display:block;width:1px;height:48px;background:rgba(255,255,255,.6)}\n    @keyframes cmpHeroZoom{from{transform:scale(1.06)}to{transform:scale(1)}}\n    @media (max-width:700px){.cmp-hero .cmp-hero__scroll{display:none}}\n  </style>\n</section>","sourceUrl":"https://interior-site-murex.vercel.app/","createdAt":"2026-10-17T08:22:51.737Z"}