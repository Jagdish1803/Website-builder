{"id":"c369df12","type":"works","label":"Design ideas by room","html":"<section class=\"cmp cmp-works section\">\n  <div class=\"container\">\n    <div class=\"cmp-works__head\">\n      <div>\n        <p class=\"eyebrow\">Design ideas</p>\n        <h2 class=\"h2\">Inspiration for every room</h2>\n        <p class=\"lead muted\">Browse ready designs by room, each with a budget range and the products used, then make any of them your own.</p>\n      </div>\n      <a class=\"btn\" href=\"/designs\">All design ideas →</a>\n    </div>\n    <div class=\"cmp-works__grid\">\n      <a class=\"cmp-works__item cmp-works__item--wide\" href=\"/designs/living-rooms\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fdesigns%2Fmodern-living-walnut.jpg&w=3840&q=75\" alt=\"Living rooms\" loading=\"lazy\"><p>Living rooms</p></a>\n      <a class=\"cmp-works__item\" href=\"/designs/bedrooms\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fdesigns%2Fluxury-master-bedroom.jpg&w=3840&q=75\" alt=\"Bedrooms\" loading=\"lazy\"><p>Bedrooms</p></a>\n      <a class=\"cmp-works__item\" href=\"/designs/kitchens\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fsite%2Fkitchen.jpg&w=3840&q=75\" alt=\"Kitchens\" loading=\"lazy\"><p>Kitchens</p></a>\n      <a class=\"cmp-works__item\" href=\"/designs/dining-rooms\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fdesigns%2Fcontemporary-dining.jpg&w=3840&q=75\" alt=\"Dining rooms\" loading=\"lazy\"><p>Dining rooms</p></a>\n      <a class=\"cmp-works__item\" href=\"/designs/kids-rooms\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fdesigns%2Fplayful-kids-room.jpg&w=3840&q=75\" alt=\"Kids’ rooms\" loading=\"lazy\"><p>Kids’ rooms</p></a>\n      <a class=\"cmp-works__item\" href=\"/designs/home-offices\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fdesigns%2Fminimal-home-office.jpg&w=3840&q=75\" alt=\"Home offices\" loading=\"lazy\"><p>Home offices</p></a>\n      <a class=\"cmp-works__item\" href=\"/designs/balconies\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fdesigns%2Fbalcony-garden-lounge.jpg&w=3840&q=75\" alt=\"Balconies\" loading=\"lazy\"><p>Balconies</p></a>\n      <a class=\"cmp-works__item cmp-works__item--wide\" href=\"/designs/bathrooms\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fdesigns%2Fspa-bathroom.jpg&w=3840&q=75\" alt=\"Bathrooms\" loading=\"lazy\"><p>Bathrooms</p></a>\n    </div>\n  </div>\n  <style>\n    .cmp-works .cmp-works__head{display:flex;justify-content:space-between;align-items:end;gap:1.5rem;flex-wrap:wrap;margin-bottom:2.5rem}\n    .cmp-works .cmp-works__head .h2{margin:.4rem 0 .75rem}\n    .cmp-works .cmp-works__head .lead{max-width:560px;margin:0}\n    .cmp-works .cmp-works__grid{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:260px;gap:1rem}\n    .cmp-works .cmp-works__item{position:relative;border-radius:var(--radius);overflow:hidden;display:block;background:var(--surface);color:#fff;text-decoration:none}\n    .cmp-works .cmp-works__item--wide{grid-column:span 2}\n    .cmp-works .cmp-works__item img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .7s ease}\n    .cmp-works .cmp-works__item::after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(0,0,0,.6))}\n    .cmp-works .cmp-works__item p{position:absolute;left:1.1rem;bottom:1rem;margin:0;z-index:1;font-weight:500;font-size:1.05rem;display:flex;align-items:center;gap:.5rem}\n    .cmp-works .cmp-works__item p::after{content:\"→\";transition:transform .3s}\n    .cmp-works .cmp-works__item:hover img{transform:scale(1.06)}\n    .cmp-works .cmp-works__item:hover p::after{transform:translateX(4px)}\n    @media (max-width:900px){.cmp-works .cmp-works__grid{grid-template-columns:repeat(2,1fr);grid-auto-rows:220px}}\n    @media (max-width:520px){.cmp-works .cmp-works__grid{grid-template-columns:1fr}.cmp-works .cmp-works__item--wide{grid-column:auto}}\n  </style>\n</section>","sourceUrl":"https://interior-site-murex.vercel.app/","createdAt":"2026-10-17T08:22:51.737Z"}