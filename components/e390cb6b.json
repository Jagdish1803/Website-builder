{"id":"e390cb6b","type":"hero","label":"Hero — built, fixed and ranked","html":"<section class=\"cmp cmp-hero section\" id=\"main\">\n  <div class=\"container\">\n    <div class=\"cmp-hero__trust\">\n      <div class=\"cmp-hero__avatars\" aria-hidden=\"true\">\n        <img src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Favatar-0.jpg&w=64&q=75\" alt=\"\">\n        <img src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Favatar-1.jpg&w=64&q=75\" alt=\"\">\n        <img src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Favatar-2.jpg&w=64&q=75\" alt=\"\">\n        <img src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Favatar-3.jpg&w=64&q=75\" alt=\"\">\n        <img src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Favatar-4.jpg&w=64&q=75\" alt=\"\">\n      </div>\n      <p>Trusted by founders.</p>\n    </div>\n\n    <h1 class=\"cmp-hero__title\">\n      <span class=\"cmp-hero__line\">Websites\n        <img class=\"cmp-hero__pill\" src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Fpill-1.jpg&w=1920&q=75\" alt=\"\">\n        Built,\n      </span>\n      <span class=\"cmp-hero__line\">Fixed &amp;\n        <img class=\"cmp-hero__pill\" src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Fpill-2.jpg&w=1920&q=75\" alt=\"\">\n        <em>Ranked</em>\n      </span>\n      <span class=\"cmp-hero__line cmp-hero__line--small\">from Mumbai,\n        <img class=\"cmp-hero__pill\" src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Fpill-3.jpg&w=1920&q=75\" alt=\"\">\n        India\n      </span>\n    </h1>\n\n    <div class=\"cmp-hero__foot\">\n      <p class=\"lead\">Custom sites built from scratch, broken ones fixed fast, and technical SEO that moves the needle — at honest prices, backed by a money-back guarantee.</p>\n      <div class=\"cmp-hero__actions\">\n        <a class=\"btn accent\" href=\"#pricing\">View Plans <span aria-hidden=\"true\">→</span></a>\n        <a class=\"btn\" href=\"#fiverr\">See Fiverr Gigs</a>\n      </div>\n    </div>\n\n    <ul class=\"cmp-hero__chips\" aria-label=\"Highlights\">\n      <li><span aria-hidden=\"true\">✳</span> Money-back guarantee</li>\n      <li><span aria-hidden=\"true\">✳</span> Clean, owned code</li>\n      <li><span aria-hidden=\"true\">✳</span> Priced per fix, not per hour</li>\n    </ul>\n  </div>\n  <style>\n    .cmp-hero{position:relative;overflow:hidden}\n    .cmp-hero::before{content:\"\";position:absolute;inset:-20% -10% auto auto;width:620px;height:620px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 22%,transparent),transparent 65%);pointer-events:none}\n    .cmp-hero .container{position:relative}\n    .cmp-hero .cmp-hero__trust{display:inline-flex;align-items:center;gap:14px;padding:6px 18px 6px 6px;border:1px solid var(--border);border-radius:999px;background:var(--surface);margin-bottom:36px}\n    .cmp-hero .cmp-hero__trust p{margin:0;font-size:.92rem;color:var(--muted)}\n    .cmp-hero .cmp-hero__avatars{display:flex}\n    .cmp-hero .cmp-hero__avatars img{width:32px;height:32px;border-radius:50%;object-fit:cover;border:2px solid var(--surface);margin-left:-10px}\n    .cmp-hero .cmp-hero__avatars img:first-child{margin-left:0}\n    .cmp-hero .cmp-hero__title{margin:0 0 40px;font-size:clamp(2.8rem,9vw,7.4rem);line-height:.98;letter-spacing:-.045em;font-weight:800;color:var(--fg)}\n    .cmp-hero .cmp-hero__line{display:flex;flex-wrap:wrap;align-items:center;gap:.18em;animation:cmpHeroRise .8s cubic-bezier(.2,.7,.2,1) both}\n    .cmp-hero .cmp-hero__line:nth-child(2){animation-delay:.08s}\n    .cmp-hero .cmp-hero__line:nth-child(3){animation-delay:.16s}\n    .cmp-hero .cmp-hero__line--small{font-size:.62em;color:var(--muted);margin-top:.15em}\n    .cmp-hero .cmp-hero__title em{font-style:italic;font-weight:400;font-family:Georgia,\"Times New Roman\",serif;color:var(--accent)}\n    .cmp-hero .cmp-hero__pill{height:.78em;width:1.9em;object-fit:cover;border-radius:999px;border:1px solid var(--border)}\n    .cmp-hero .cmp-hero__foot{display:grid;grid-template-columns:1.3fr auto;gap:32px;align-items:end;padding-top:32px;border-top:1px solid var(--border)}\n    .cmp-hero .cmp-hero__foot .lead{margin:0;max-width:56ch}\n    .cmp-hero .cmp-hero__actions{display:flex;gap:12px;flex-wrap:wrap}\n    .cmp-hero .cmp-hero__chips{display:flex;flex-wrap:wrap;gap:10px;list-style:none;padding:0;margin:32px 0 0}\n    .cmp-hero .cmp-hero__chips li{font-size:.88rem;color:var(--muted);padding:8px 14px;border-radius:999px;border:1px dashed var(--border)}\n    .cmp-hero .cmp-hero__chips span{color:var(--accent)}\n    @keyframes cmpHeroRise{from{transform:translateY(18px)}to{transform:none}}\n    @media (max-width:800px){.cmp-hero .cmp-hero__foot{grid-template-columns:1fr}}\n    @media (prefers-reduced-motion:reduce){.cmp-hero .cmp-hero__line{animation:none}}\n  </style>\n</section>","sourceUrl":"https://logicloomweb.com/","createdAt":"2026-10-17T07:15:21.668Z"}