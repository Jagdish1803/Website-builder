cmp-works__item:hover .cmp-works__arrow{background:var(--accent);color:var(--accent-contrast);border-color:var(--accent)}\n    @media (max-width:860px){.cmp-works .cmp-works__head,.cmp-works .cmp-works__item{grid-template-columns:1fr}.cmp-works .cmp-works__head .lead{justify-self:start}}\n  </style>\n</section>","sourceUrl":"https://logicloomweb.com/","createdAt":"2026-10-17T07:15:21.668Z"}