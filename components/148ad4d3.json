{"id":"148ad4d3","type":"contact","label":"Contact details and newsletter","html":"<section class=\"cmp cmp-contact section\" id=\"contact\">\n  <div class=\"container\">\n    <div class=\"cmp-contact__grid\">\n      <div class=\"cmp-contact__intro\">\n        <span class=\"eyebrow\">Hello! We're listening</span>\n        <h2 class=\"h2\">Let's talk about your project</h2>\n        <a class=\"btn accent\" href=\"mailto:contact@zootdigitalseo.com\">Sound good? Let's connect!</a>\n        <div class=\"cmp-contact__social\">\n          <p class=\"muted\">Follow us</p>\n          <ul>\n            <li><a href=\"#\">Youtube</a></li>\n            <li><a href=\"#\">Twitter</a></li>\n            <li><a href=\"#\">Instagram</a></li>\n            <li><a href=\"#\">LinkedIn</a></li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"cmp-contact__cards\">\n        <div class=\"card\">\n          <p class=\"cmp-contact__label\">Connect with us</p>\n          <ul class=\"cmp-contact__lines\">\n            <li><span aria-hidden=\"true\">📧</span><a href=\"mailto:contact@zootdigitalseo.com\">contact@zootdigitalseo.com</a></li>\n            <li><span aria-hidden=\"true\">💬</span><a href=\"tel:+919082729185\">+919082729185</a></li>\n            <li><span aria-hidden=\"true\">🕒</span><span>Monday → Sunday 10am to 7pm</span></li>\n          </ul>\n        </div>\n        <div class=\"card\">\n          <p class=\"cmp-contact__label\">Address</p>\n          <p>U Wing, 3069, 3rd Floor, Janta Market Rd, opposite APMC Fruits and Vegetable Market, Sector 25, Vashi, Navi Mumbai, Maharashtra 400703</p>\n        </div>\n        <form class=\"card cmp-contact__form\" action=\"#\" method=\"post\">\n          <label class=\"cmp-contact__label\" for=\"cmp-contact-email\">Join our newsletter</label>\n          <div class=\"cmp-contact__row\">\n            <input id=\"cmp-contact-email\" type=\"email\" name=\"email\" placeholder=\"you@company.com\" required>\n            <button class=\"btn accent\" type=\"submit\">Submit</button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n  <style>\n    .cmp-contact .cmp-contact__grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;align-items:start}\n    .cmp-contact .cmp-contact__intro > * + *{margin-top:16px}\n    .cmp-contact .cmp-contact__intro .btn{margin-top:24px}\n    .cmp-contact .cmp-contact__social{margin-top:36px}\n    .cmp-contact .cmp-contact__social ul{list-style:none;padding:0;margin:10px 0 0;display:flex;flex-wrap:wrap;gap:8px}\n    .cmp-contact .cmp-contact__social a{display:inline-block;padding:8px 14px;border:1px solid var(--border);border-radius:999px;color:var(--fg);text-decoration:none;font-size:.9rem}\n    .cmp-contact .cmp-contact__social a:hover{border-color:var(--accent);color:var(--accent)}\n    .cmp-contact .cmp-contact__cards{display:grid;gap:14px}\n    .cmp-contact .cmp-contact__label{display:block;font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;font-weight:700;color:var(--muted);margin:0 0 10px}\n    .cmp-contact .card p{margin:0}\n    .cmp-contact .cmp-contact__lines{list-style:none;padding:0;margin:0;display:grid;gap:10px}\n    .cmp-contact .cmp-contact__lines li{display:flex;gap:10px;align-items:center}\n    .cmp-contact .cmp-contact__lines a{color:var(--fg);font-weight:600;text-decoration:none}\n    .cmp-contact .cmp-contact__lines a:hover{color:var(--accent)}\n    .cmp-contact .cmp-contact__row{display:flex;gap:8px;flex-wrap:wrap}\n    .cmp-contact .cmp-contact__row input{flex:1 1 220px;padding:12px 14px;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--bg);color:var(--fg);font:inherit}\n    @media (max-width:860px){.cmp-contact .cmp-contact__grid{grid-template-columns:1fr}}\n  </style>\n</section>","sourceUrl":"https://zootwebagency.com/","createdAt":"2026-10-17T07:19:35.275Z"}