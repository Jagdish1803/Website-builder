{"id":"4307f773","type":"shop","label":"Shop categories and bestsellers","html":"<section class=\"cmp cmp-shop section\">\n  <div class=\"container\">\n    <div class=\"cmp-shop__intro\">\n      <div>\n        <p class=\"eyebrow\">The shop</p>\n        <h2 class=\"h2\">Finishing touches, delivered</h2>\n      </div>\n      <div>\n        <p class=\"muted\">Ready-made products ship across India. Made-to-measure blinds, flooring and grills include measurement and installation.</p>\n        <a class=\"btn\" href=\"/shop\">Visit the shop →</a>\n      </div>\n    </div>\n\n    <ol class=\"cmp-shop__cats\">\n      <li><a href=\"/shop/window-films\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Ffrosted-privacy-film.jpg&w=3840&q=75\" alt=\"\" loading=\"lazy\"><span><em>(01)</em>Window films</span></a></li>\n      <li><a href=\"/shop/blinds\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Flinen-roman-blind.jpg&w=3840&q=75\" alt=\"\" loading=\"lazy\"><span><em>(02)</em>Blinds</span></a></li>\n      <li><a href=\"/shop/flooring\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Fengineered-wood-flooring.jpg&w=3840&q=75\" alt=\"\" loading=\"lazy\"><span><em>(03)</em>Flooring</span></a></li>\n      <li><a href=\"/shop/wallpapers\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Fbotanical-wallpaper.jpg&w=3840&q=75\" alt=\"\" loading=\"lazy\"><span><em>(04)</em>Wallpapers</span></a></li>\n      <li><a href=\"/shop/paints\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Fcolour-swatches.jpg&w=3840&q=75\" alt=\"\" loading=\"lazy\"><span><em>(05)</em>Paints</span></a></li>\n      <li><a href=\"/shop/curtains\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Fsheer-linen-curtains.jpg&w=3840&q=75\" alt=\"\" loading=\"lazy\"><span><em>(06)</em>Curtains</span></a></li>\n      <li><a href=\"/shop/invisible-grills\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Fbalcony-invisible-grill.jpg&w=3840&q=75\" alt=\"\" loading=\"lazy\"><span><em>(07)</em>Invisible grills</span></a></li>\n      <li><a href=\"/shop/awnings\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Fretractable-awning.jpg&w=3840&q=75\" alt=\"\" loading=\"lazy\"><span><em>(08)</em>Awnings</span></a></li>\n      <li><a href=\"/shop/mosquito-nets\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Fpleated-mosquito-net.jpg&w=3840&q=75\" alt=\"\" loading=\"lazy\"><span><em>(09)</em>Mosquito nets</span></a></li>\n    </ol>\n\n    <div class=\"cmp-shop__best\">\n      <p class=\"eyebrow\">Bestsellers</p>\n      <div class=\"cmp-shop__products\">\n        <a class=\"cmp-shop__product\" href=\"/shop/blinds/linen-roman-blind\">\n          <div class=\"cmp-shop__pimg\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Flinen-roman-blind.jpg&w=3840&q=75\" alt=\"Linen Roman blind\" loading=\"lazy\"><span class=\"tag\">Made to measure</span></div>\n          <h3 class=\"h3\">Linen Roman blind</h3>\n          <p class=\"muted\">Blinds · From ₹260 / sq ft</p>\n        </a>\n        <a class=\"cmp-shop__product\" href=\"/shop/flooring/spc-vinyl-plank\">\n          <div class=\"cmp-shop__pimg\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Fspc-vinyl-plank.jpg&w=3840&q=75\" alt=\"Room with wood-look vinyl plank flooring\" loading=\"lazy\"><span class=\"tag\">Made to measure</span></div>\n          <h3 class=\"h3\">SPC vinyl plank flooring</h3>\n          <p class=\"muted\">Flooring · From ₹140 / sq ft</p>\n        </a>\n        <a class=\"cmp-shop__product\" href=\"/shop/blinds/blackout-roller-blind\">\n          <div class=\"cmp-shop__pimg\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Fblackout-roller-blind.jpg&w=3840&q=75\" alt=\"Roller blind half-lowered over a bright window\" loading=\"lazy\"><span class=\"tag\">Made to measure</span></div>\n          <h3 class=\"h3\">Blackout roller blind</h3>\n          <p class=\"muted\">Blinds · From ₹165 / sq ft</p>\n        </a>\n        <a class=\"cmp-shop__product\" href=\"/shop/wallpapers/botanical-leaf-wallpaper\">\n          <div class=\"cmp-shop__pimg\"><img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fproducts%2Fbotanical-wallpaper.jpg&w=3840&q=75\" alt=\"Botanical leaf wallpaper\" loading=\"lazy\"></div>\n          <h3 class=\"h3\">Botanical leaf wallpaper</h3>\n          <p class=\"muted\">Wallpapers · From ₹3,290</p>\n        </a>\n      </div>\n    </div>\n  </div>\n  <style>\n    .cmp-shop .cmp-shop__intro{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:end;margin-bottom:2.5rem}\n    .cmp-shop .cmp-shop__intro .h2{margin:.4rem 0 0}\n    .cmp-shop .cmp-shop__intro .muted{margin:0 0 1.25rem;max-width:48ch}\n    .cmp-shop .cmp-shop__cats{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem}\n    .cmp-shop .cmp-shop__cats a{display:flex;align-items:center;gap:1rem;padding:.6rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--fg);text-decoration:none;transition:border-color .2s,transform .2s}\n    .cmp-shop .cmp-shop__cats a:hover{border-color:var(--accent);transform:translateY(-2px)}\n    .cmp-shop .cmp-shop__cats img{width:64px;height:64px;border-radius:var(--radius-sm);object-fit:cover;flex:none}\n    .cmp-shop .cmp-shop__cats span{font-weight:500}\n    .cmp-shop .cmp-shop__cats em{font-style:normal;color:var(--muted);font-size:.8rem;margin-right:.6rem;font-weight:400}\n    .cmp-shop .cmp-shop__best{margin-top:clamp(3rem,6vw,4.5rem)}\n    .cmp-shop .cmp-shop__products{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem;margin-top:1rem}\n    .cmp-shop .cmp-shop__product{color:var(--fg);text-decoration:none;display:block}\n    .cmp-shop .cmp-shop__pimg{position:relative;aspect-ratio:4/5;border-radius:var(--radius);overflow:hidden;background:var(--surface)}\n    .cmp-shop .cmp-shop__pimg img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s ease}\n    .cmp-shop .cmp-shop__product:hover .cmp-shop__pimg img{transform:scale(1.05)}\n    .cmp-shop .cmp-shop__pimg .tag{position:absolute;top:.75rem;left:.75rem;background:var(--bg)}\n    .cmp-shop .cmp-shop__product .h3{margin:1rem 0 .25rem;font-size:1.08rem}\n    .cmp-shop .cmp-shop__product .muted{margin:0;font-size:.92rem}\n    @media (max-width:900px){.cmp-shop .cmp-shop__intro{grid-template-columns:1fr}.cmp-shop .cmp-shop__cats{grid-template-columns:repeat(2,1fr)}.cmp-shop .cmp-shop__products{grid-template-columns:repeat(2,1fr)}}\n    @media (max-width:520px){.cmp-shop .cmp-shop__cats{grid-template-columns:1fr}}\n  </style>\n</section>","sourceUrl":"https://interior-site-murex.vercel.app/","createdAt":"2026-10-17T08:22:51.737Z"}