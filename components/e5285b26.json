{"id":"e5285b26","type":"pricing","label":"Instant home estimate","html":"<section class=\"cmp cmp-pricing section\">\n  <div class=\"container\">\n    <div class=\"cmp-pricing__card\">\n      <div class=\"cmp-pricing__media\">\n        <img src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fsite%2Fhero-bedroom.jpg&w=3840&q=75\" alt=\"A finished bedroom interior\" loading=\"lazy\">\n      </div>\n      <div class=\"cmp-pricing__body\">\n        <p class=\"eyebrow\">Instant estimate</p>\n        <h2 class=\"h2\">What would your home cost?</h2>\n        <p class=\"muted\">Full home interiors. No phone number, no OTP.</p>\n\n        <div class=\"cmp-pricing__group\">\n          <p class=\"cmp-pricing__label\">Home size</p>\n          <div class=\"cmp-pricing__chips\">\n            <a class=\"cmp-pricing__chip\" href=\"/estimate?size=1bhk\">1 BHK</a>\n            <a class=\"cmp-pricing__chip is-active\" href=\"/estimate?size=2bhk\" aria-current=\"true\">2 BHK</a>\n            <a class=\"cmp-pricing__chip\" href=\"/estimate?size=3bhk\">3 BHK</a>\n            <a class=\"cmp-pricing__chip\" href=\"/estimate?size=4bhk\">4 BHK+</a>\n          </div>\n        </div>\n        <div class=\"cmp-pricing__group\">\n          <p class=\"cmp-pricing__label\">Finish level</p>\n          <div class=\"cmp-pricing__chips\">\n            <a class=\"cmp-pricing__chip is-active\" href=\"/estimate?tier=essential\" aria-current=\"true\">Essential</a>\n            <a class=\"cmp-pricing__chip\" href=\"/estimate?tier=premium\">Premium</a>\n            <a class=\"cmp-pricing__chip\" href=\"/estimate?tier=luxe\">Luxe</a>\n          </div>\n        </div>\n\n        <div class=\"cmp-pricing__result\">\n          <p class=\"cmp-pricing__price\">₹9.7 lakh – ₹12 lakh</p>\n          <p class=\"muted\">Kitchen, wardrobes, living, bedrooms, ceiling and painting. GST included.</p>\n        </div>\n        <a class=\"btn accent\" href=\"/estimate\">See the full breakdown →</a>\n      </div>\n    </div>\n  </div>\n  <style>\n    .cmp-pricing .cmp-pricing__card{display:grid;grid-template-columns:1fr 1.1fr;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}\n    .cmp-pricing .cmp-pricing__media{min-height:320px}\n    .cmp-pricing .cmp-pricing__media img{width:100%;height:100%;object-fit:cover;display:block}\n    .cmp-pricing .cmp-pricing__body{padding:clamp(1.75rem,4vw,3.5rem)}\n    .cmp-pricing .h2{margin:.4rem 0 .5rem}\n    .cmp-pricing .cmp-pricing__group{margin-top:1.75rem}\n    .cmp-pricing .cmp-pricing__label{font-size:.78rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin:0 0 .65rem}\n    .cmp-pricing .cmp-pricing__chips{display:flex;flex-wrap:wrap;gap:.5rem}\n    .cmp-pricing .cmp-pricing__chip{padding:.6rem 1.1rem;border:1px solid var(--border);border-radius:999px;color:var(--fg);text-decoration:none;font-size:.92rem;background:var(--bg);transition:border-color .2s,background .2s}\n    .cmp-pricing .cmp-pricing__chip:hover{border-color:var(--fg)}\n    .cmp-pricing .cmp-pricing__chip.is-active{background:var(--fg);color:var(--bg);border-color:var(--fg)}\n    .cmp-pricing .cmp-pricing__result{margin:2rem 0 1.5rem;padding:1.5rem 0 0;border-top:1px dashed var(--border)}\n    .cmp-pricing .cmp-pricing__price{font-size:clamp(1.8rem,3.6vw,2.6rem);font-weight:600;letter-spacing:-.02em;margin:0 0 .4rem;color:var(--fg)}\n    .cmp-pricing .cmp-pricing__result .muted{margin:0}\n    @media (max-width:860px){.cmp-pricing .cmp-pricing__card{grid-template-columns:1fr}.cmp-pricing .cmp-pricing__media{aspect-ratio:16/9;min-height:0}}\n  </style>\n</section>","sourceUrl":"https://interior-site-murex.vercel.app/","createdAt":"2026-10-17T08:22:51.737Z"}