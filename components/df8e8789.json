{"id":"df8e8789","type":"team","label":"Meet the minds behind Zoot","html":"<section class=\"cmp cmp-team section\" id=\"team\">\n  <div class=\"container\">\n    <div class=\"cmp-team__head\">\n      <span class=\"eyebrow\">Our Team</span>\n      <h2 class=\"h2\">Meet The Minds Behind Zoot</h2>\n      <p class=\"lead muted\">A multidisciplinary team of developers, designers, and SEO strategists creating high-performance digital solutions that drive measurable business growth.</p>\n    </div>\n    <img class=\"cmp-team__group\" src=\"https://zootwebagency.com/_next/image/?url=%2Fuploads%2F2026%2F03%2FGroup-Photo-scaled.png&w=3840&q=75&dpl=dpl_5T2BU7UNNuondXuXiGnhzzGeNHdu\" alt=\"The Zoot Web Agency team\">\n    <div class=\"cmp-team__leads\">\n      <article class=\"card cmp-team__lead\"><img src=\"https://zootwebagency.com/_next/image/?url=%2Fuploads%2F2026%2F01%2F420ceb3c-249a-47b9-8d2b-509fa1c94ad5.jpg&w=256&q=75&dpl=dpl_5T2BU7UNNuondXuXiGnhzzGeNHdu\" alt=\"Prasad Pol\"><h3 class=\"h3\">Prasad Pol</h3><p class=\"muted\">Director/Founder</p></article>\n      <article class=\"card cmp-team__lead\"><img src=\"https://zootwebagency.com/_next/image/?url=%2Fuploads%2F2026%2F01%2FWhatsApp-Image-2026-01-03-at-4.43.11-PM.jpeg&w=256&q=75&dpl=dpl_5T2BU7UNNuondXuXiGnhzzGeNHdu\" alt=\"Mageshwaram\"><h3 class=\"h3\">Mageshwaram</h3><p class=\"muted\">Manager</p></article>\n      <article class=\"card cmp-team__lead\"><img src=\"https://zootwebagency.com/_next/image/?url=%2Fuploads%2F2026%2F01%2FWhatsApp-Image-2026-01-03-at-4.43.12-PM.jpeg&w=256&q=75&dpl=dpl_5T2BU7UNNuondXuXiGnhzzGeNHdu\" alt=\"Aishwarya\"><h3 class=\"h3\">Aishwarya</h3><p class=\"muted\">Human Resources (HR)</p></article>\n      <article class=\"card cmp-team__lead\"><img src=\"https://zootwebagency.com/_next/image/?url=%2Fuploads%2F2025%2F12%2FIMG_6538-1.png&w=256&q=75&dpl=dpl_5T2BU7UNNuondXuXiGnhzzGeNHdu\" alt=\"Divya\"><h3 class=\"h3\">Divya</h3><p class=\"muted\">SEO Specialists (Team Leader)</p></article>