{"id":"0467dc86","type":"contact","label":"Contact form and email marquee","html":"<section class=\"cmp cmp-contact section\" id=\"contact\">\n  <div class=\"container\">\n    <div class=\"cmp-contact__grid\">\n      <div class=\"cmp-contact__intro\">\n        <p class=\"eyebrow\">(Let's Connect)</p>\n        <h2 class=\"h2\">Got a project in mind?</h2>\n        <p class=\"lead muted\">Let's make something happen together.</p>\n        <a class=\"cmp-contact__mail\" href=\"mailto:logicloomweb@gmail.com\">logicloomweb@gmail.com <span aria-hidden=\"true\">↗</span></a>\n        <p class=\"muted cmp-contact__note\">Broken site? Send the URL — we reply the same working day with what is wrong, what it costs and how long it takes.</p>\n      </div>\n      <form class=\"card cmp-contact__form\" action=\"mailto:logicloomweb@gmail.com\" method=\"post\" enctype=\"text/plain\">\n        <label>Your Name<input type=\"text\" name=\"name\" autocomplete=\"name\" placeholder=\"Jane Doe\" required></label>\n        <label>Your Email<input type=\"email\" name=\"email\" autocomplete=\"email\" placeholder=\"jane@company.com\" required></label>\n        <label>Project Description<textarea name=\"project\" rows=\"5\" placeholder=\"Tell us what you need built, fixed or ranked…\" required></textarea></label>\n        <button class=\"btn accent\" type=\"submit\">Send Now! →</button>\n      </form>\n    </div>\n  </div>\n  <div class=\"cmp-contact__marquee\" aria-hidden=\"true\">\n    <div class=\"cmp-contact__track\">\n      <span>logicloomweb@gmail.com ✳</span><span>logicloomweb@gmail.com ✳</span><span>logicloomweb@gmail.com ✳</span><span>logicloomweb@gmail.com ✳</span><span>logicloomweb@gmail.com ✳</span>\n      <span>logicloomweb@gmail.com ✳</span><span>logicloomweb@gmail.com ✳</span><span>logicloomweb@gmail.com ✳</span><span>logicloomweb@gmail.com ✳</span><span>logicloomweb@gmail.com ✳</span>\n    </div>\n  </div>\n  <style>\n    .cmp-contact{overflow:hidden}\n    .cmp-contact .cmp-contact__grid{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(32px,5vw,72px);align-items:start}\n    .cmp-contact .cmp-contact__intro .h2{margin:8px 0 12px}\n    .cmp-contact .cmp-contact__intro .lead{margin:0 0 28px}\n    .cmp-contact .cmp-contact__mail{display:inline-flex;gap:8px;font-size:clamp(1.2rem,2.4vw,1.7rem);font-weight:700;color:var(--fg);text-decoration:none;border-bottom:2px solid var(--accent);padding-bottom:4px;word-break:break-all}\n    .cmp-contact .cmp-contact__mail:hover{color:var(--accent)}\n    .cmp-contact .cmp-contact__note{margin:24px 0 0;max-width:44ch;font-size:.95rem}\n    .cmp-contact .cmp-contact__form{display:grid;gap:18px;padding:clamp(24px,3vw,36px)}\n    .cmp-contact .cmp-contact__form label{display:grid;gap:8px;font-size:.88rem;font-weight:600;color:var(--muted)}\n    .cmp-contact .cmp-contact__form input,.cmp-contact .cmp-contact__form textarea{font:inherit;font-size:1rem;color:var(--fg);background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px 16px;resize:vertical;transition:border-color .2s,box-shadow .2s}\n    .cmp-contact .cmp-contact__form input:focus,.cmp-contact .cmp-contact__form textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 22%,transparent)}\n    .cmp-contact .cmp-contact__form .btn{justify-self:start}\n    .cmp-contact .cmp-contact__marquee{margin-top:clamp(48px,8vw,96px);border-block:1px solid var(--border);padding:22px 0;overflow:hidden}\n    .cmp-contact .cmp-contact__track{display:flex;gap:48px;width:max-content;animation:cmpContactScroll 40s linear infinite}\n    .cmp-contact .cmp-contact__track span{font-size:clamp(1.6rem,4vw,3rem);font-weight:800;letter-spacing:-.03em;white-space:nowrap;color:var(--fg)}\n    .cmp-contact .cmp-contact__track span:nth-child(even){color:transparent;-webkit-text-stroke:1px var(--muted)}\n    @keyframes cmpContactScroll{to{transform:translateX(-50%)}}\n    @media (max-width:860px){.cmp-contact .cmp-contact__grid{grid-template-columns:1fr}}\n    @media (prefers-reduced-motion:reduce){.cmp-contact .cmp-contact__track{animation:none}}\n  </style>\n</section>","sourceUrl":"https://logicloomweb.com/","createdAt":"2026-10-17T07:15:21.668Z"}