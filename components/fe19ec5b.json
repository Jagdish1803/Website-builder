{"id":"fe19ec5b","type":"services","label":"What we do — four services","html":"<section class=\"cmp cmp-services section\" id=\"services\">\n  <div class=\"container\">\n    <div class=\"cmp-services__head\">\n      <p class=\"eyebrow\">(Services)</p>\n      <h2 class=\"h2\">What we do</h2>\n      <nav class=\"cmp-services__jump\" aria-label=\"Services\">\n        <a href=\"#svc-web\">Website Development</a>\n        <a href=\"#svc-fix\">Fixes &amp; Maintenance</a>\n        <a href=\"#svc-seo\">SEO &amp; Performance</a>\n        <a href=\"#svc-cms\">WordPress &amp; Shopify</a>\n      </nav>\n    </div>\n\n    <div class=\"grid-2 cmp-services__grid\">\n      <article class=\"card cmp-services__card\" id=\"svc-web\">\n        <div class=\"cmp-services__img\"><img src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Fservice-web.jpg&w=1920&q=75\" alt=\"\" loading=\"lazy\"><span class=\"cmp-services__num\">01</span></div>\n        <div class=\"cmp-services__body\">\n          <h3 class=\"h3\">Website Development</h3>\n          <p class=\"muted\">A website built from scratch — structure, design, code and launch. Fast, mobile-first and yours to own, with no page-builder lock-in.</p>\n          <ul><li class=\"tag\">Next.js &amp; React</li><li class=\"tag\">Responsive Build</li><li class=\"tag\">Domain &amp; Deploy</li></ul>\n        </div>\n      </article>\n      <article class=\"card cmp-services__card\" id=\"svc-fix\">\n        <div class=\"cmp-services__img\"><img src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Fservice-fix.jpg&w=1920&q=75\" alt=\"\" loading=\"lazy\"><span class=\"cmp-services__num\">02</span></div>\n        <div class=\"cmp-services__body\">\n          <h3 class=\"h3\">Fixes &amp; Maintenance</h3>\n          <p class=\"muted\">Something broken, slow or throwing errors? We diagnose it, fix it and tell you plainly what went wrong — then keep it healthy month to month.</p>\n          <ul><li class=\"tag\">Bug Fixing</li><li class=\"tag\">Broken Layouts</li><li class=\"tag\">Ongoing Care</li></ul>\n        </div>\n      </article>\n      <article class=\"card cmp-services__card\" id=\"svc-seo\">\n        <div class=\"cmp-services__img\"><img src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Fservice-seo.jpg&w=1920&q=75\" alt=\"\" loading=\"lazy\"><span class=\"cmp-services__num\">03</span></div>\n        <div class=\"cmp-services__body\">\n          <h3 class=\"h3\">SEO &amp; Performance</h3>\n          <p class=\"muted\">Rankings follow the fundamentals: clean markup, fast pages, correct metadata. We fix all three and hand you a before/after report.</p>\n          <ul><li class=\"tag\">Technical SEO</li><li class=\"tag\">Core Web Vitals</li><li class=\"tag\">Schema &amp; Sitemaps</li></ul>\n        </div>\n      </article>\n      <article class=\"card cmp-services__card\" id=\"svc-cms\">\n        <div class=\"cmp-services__img\"><img src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Fservice-cms.jpg&w=1920&q=75\" alt=\"\" loading=\"lazy\"><span class=\"cmp-services__num\">04</span></div>\n        <div class=\"cmp-services__body\">\n          <h3 class=\"h3\">WordPress &amp; Shopify</h3>\n          <p class=\"muted\">CMS and store work done carefully — custom sections, product pages, checkout tweaks and migrations that do not break what already works.</p>\n          <ul><li class=\"tag\">Theme Customisation</li><li class=\"tag\">Ecommerce</li><li class=\"tag\">Migrations</li></ul>\n        </div>\n      </article>\n    </div>\n  </div>\n  <style>\n    .cmp-services{background:var(--surface);border-block:1px solid var(--border)}\n    .cmp-services .cmp-services__head{margin-bottom:40px}\n    .cmp-services .cmp-services__head .h2{margin:8px 0 24px}\n    .cmp-services .cmp-services__jump{display:flex;flex-wrap:wrap;gap:10px}\n    .cmp-services .cmp-services__jump a{padding:10px 18px;border-radius:999px;border:1px solid var(--border);background:var(--bg);color:var(--fg);text-decoration:none;font-size:.92rem;transition:border-color .2s,color .2s}\n    .cmp-services .cmp-services__jump a:hover{border-color:var(--accent);color:var(--accent)}\n    .cmp-services .cmp-services__grid{gap:24px}\n    .cmp-services .cmp-services__card{padding:0;overflow:hidden;background:var(--bg);display:flex;flex-direction:column;scroll-margin-top:100px;transition:border-color .25s}\n    .cmp-services .cmp-services__card:hover{border-color:var(--accent)}\n    .cmp-services .cmp-services__img{position:relative;aspect-ratio:16/8;overflow:hidden}\n    .cmp-services .cmp-services__img img{width:100%;height:100%;object-fit:cover;display:block}\n    .cmp-services .cmp-services__num{position:absolute;left:16px;top:16px;padding:6px 12px;border-radius:999px;background:var(--bg);color:var(--fg);font-family:ui-monospace,Menlo,monospace;font-size:.8rem}\n    .cmp-services .cmp-services__body{padding:28px;display:flex;flex-direction:column;gap:12px;flex:1}\n    .cmp-services .cmp-services__body .h3,.cmp-services .cmp-services__body p{margin:0}\n    .cmp-services .cmp-services__body ul{list-style:none;padding:0;margin:auto 0 0;display:flex;flex-wrap:wrap;gap:8px;padding-top:8px}\n  </style>\n</section>","sourceUrl":"https://logicloomweb.com/","createdAt":"2026-10-17T07:15:21.668Z"}