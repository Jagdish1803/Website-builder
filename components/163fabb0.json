{"id":"163fabb0","type":"header","label":"Top navigation bar","html":"<section class=\"cmp cmp-header\">\n  <div class=\"container\">\n    <a class=\"cmp-header__skip\" href=\"#main\">Skip to content</a>\n    <div class=\"cmp-header__bar\">\n      <a class=\"cmp-header__logo\" href=\"/\" aria-label=\"Interior Studio home\">INTERIOR<span>STUDIO</span></a>\n      <nav class=\"cmp-header__nav\" aria-label=\"Primary\">\n        <a href=\"/services\">Services</a>\n        <a href=\"/designs\">Designs</a>\n        <a href=\"/portfolio\">Portfolio</a>\n        <a href=\"/shop\">Shop</a>\n        <a href=\"/estimate\">Estimate</a>\n        <a href=\"/about\">About</a>\n        <a href=\"/contact\">Contact</a>\n      </nav>\n      <div class=\"cmp-header__actions\">\n        <a class=\"cmp-header__signin\" href=\"/account\">Sign in</a>\n        <a class=\"btn accent\" href=\"/contact\">Book a consultation</a>\n      </div>\n    </div>\n  </div>\n  <style>\n    .cmp-header{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}\n    .cmp-header .cmp-header__skip{position:absolute;left:1rem;top:-3rem;padding:.5rem .9rem;background:var(--accent);color:var(--accent-contrast);border-radius:var(--radius-sm);text-decoration:none;font-size:.85rem}\n    .cmp-header .cmp-header__skip:focus{top:.5rem}\n    .cmp-header .cmp-header__bar{display:flex;align-items:center;gap:2rem;padding:1rem 0}\n    .cmp-header .cmp-header__logo{font-weight:700;letter-spacing:.18em;font-size:.95rem;color:var(--fg);text-decoration:none;white-space:nowrap}\n    .cmp-header .cmp-header__logo span{font-weight:300;color:var(--muted)}\n    .cmp-header .cmp-header__nav{display:flex;gap:1.5rem;flex:1;overflow-x:auto;scrollbar-width:none}\n    .cmp-header .cmp-header__nav a{color:var(--muted);text-decoration:none;font-size:.92rem;white-space:nowrap;transition:color .2s}\n    .cmp-header .cmp-header__nav a:hover{color:var(--fg)}\n    .cmp-header .cmp-header__actions{display:flex;align-items:center;gap:1rem;white-space:nowrap}\n    .cmp-header .cmp-header__signin{color:var(--fg);text-decoration:none;font-size:.92rem}\n    @media (max-width:900px){\n      .cmp-header .cmp-header__bar{flex-wrap:wrap;gap:.75rem 1.25rem}\n      .cmp-header .cmp-header__nav{order:3;flex-basis:100%}\n      .cmp-header .cmp-header__actions{margin-left:auto}\n    }\n  </style>\n</section>","sourceUrl":"https://interior-site-murex.vercel.app/","createdAt":"2026-10-17T08:22:51.737Z"}