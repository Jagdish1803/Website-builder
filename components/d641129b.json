{"id":"d641129b","type":"process","label":"How it works steps","html":"<section class=\"cmp cmp-process section\">\n  <div class=\"container\">\n    <div class=\"cmp-process__head\">\n      <p class=\"eyebrow\">How it works</p>\n      <h2 class=\"h2\">From first conversation to final walkthrough</h2>\n    </div>\n    <ol class=\"cmp-process__steps\">\n      <li><span class=\"cmp-process__dot\">01</span><h3 class=\"h3\">Meet your architect</h3><p class=\"muted\">A free session online or at your site to understand your space, routine and budget.</p><span class=\"tag\">Free</span></li>\n      <li><span class=\"cmp-process__dot\">02</span><h3 class=\"h3\">Design together</h3><p class=\"muted\">Layouts, materials and 3D views. Revise until every room feels right.</p><span class=\"tag\">No payment yet</span></li>\n      <li><span class=\"cmp-process__dot\">03</span><h3 class=\"h3\">Approve the quote</h3><p class=\"muted\">An itemised quote you can review, accept and pay for online.</p><span class=\"tag\">Advance to begin</span></li>\n      <li><span class=\"cmp-process__dot\">04</span><h3 class=\"h3\">We build</h3><p class=\"muted\">Our team handles materials, carpentry, civil work and installation on a clear schedule.</p><span class=\"tag\">Nothing extra</span></li>\n      <li><span class=\"cmp-process__dot\">05</span><h3 class=\"h3\">Move in</h3><p class=\"muted\">A final walkthrough, snags closed out, and a home ready to live in.</p><span class=\"tag\">Balance at handover</span></li>\n    </ol>\n  </div>\n  <style>\n    .cmp-process .cmp-process__head{max-width:680px;margin-bottom:3rem}\n    .cmp-process .cmp-process__head .h2{margin:.4rem 0 0}\n    .cmp-process .cmp-process__steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,1fr);gap:1.5rem;position:relative}\n    .cmp-process .cmp-process__steps::before{content:\"\";position:absolute;top:1.3rem;left:1.3rem;right:1.3rem;height:1px;background:var(--border)}\n    .cmp-process .cmp-process__steps li{position:relative;display:flex;flex-direction:column;align-items:flex-start}\n    .cmp-process .cmp-process__dot{display:grid;place-items:center;width:2.6rem;height:2.6rem;border-radius:50%;background:var(--accent);color:var(--accent-contrast);font-size:.8rem;font-weight:600;margin-bottom:1.5rem;position:relative;box-shadow:0 0 0 6px var(--bg)}\n    .cmp-process .h3{margin:0 0 .5rem;font-size:1.1rem}\n    .cmp-process .muted{margin:0 0 1rem;font-size:.95rem;flex:1}\n    @media (max-width:900px){\n      .cmp-process .cmp-process__steps{grid-template-columns:1fr;gap:2rem}\n      .cmp-process .cmp-process__steps::before{top:0;bottom:0;left:1.3rem;right:auto;width:1px;height:auto}\n      .cmp-process .cmp-process__steps li{padding-left:4rem}\n      .cmp-process .cmp-process__dot{position:absolute;left:0;top:0;margin:0}\n    }\n  </style>\n</section>","sourceUrl":"https://interior-site-murex.vercel.app/","createdAt":"2026-10-17T08:22:51.737Z"}