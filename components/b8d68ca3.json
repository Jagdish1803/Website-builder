{"id":"b8d68ca3","type":"testimonials","label":"Testimonials and highlights","html":"<section class=\"cmp cmp-testimonials section\">\n  <div class=\"container\">\n    <div class=\"cmp-testimonials__head\">\n      <p class=\"eyebrow\">(Why clients love LLW)</p>\n      <h2 class=\"h2\">Testimonials</h2>\n    </div>\n\n    <div class=\"cmp-testimonials__grid\">\n      <ul class=\"cmp-testimonials__stats\" aria-label=\"What clients get\">\n        <li class=\"card\">\n          <span class=\"cmp-testimonials__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\"><path d=\"M4 7h16v12H4zM9 7V4h6v3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/></svg>\n          </span>\n          <p>Projects Delivered</p>\n        </li>\n        <li class=\"card\">\n          <span class=\"cmp-testimonials__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\"><path d=\"M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/></svg>\n          </span>\n          <p>Client satisfaction rate</p>\n        </li>\n        <li class=\"card\">\n          <span class=\"cmp-testimonials__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\"><circle cx=\"12\" cy=\"12\" r=\"8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M12 8v4l3 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n          </span>\n          <p>Average first reply</p>\n        </li>\n      </ul>\n\n      <figure class=\"cmp-testimonials__quote card\">\n        <div class=\"cmp-testimonials__meta\">\n          <span class=\"tag\">01 / 03</span>\n          <span class=\"cmp-testimonials__stars\" aria-label=\"5 out of 5\">★★★★★</span>\n        </div>\n        <blockquote>“Our old site broke every second week. LLW rebuilt it in three weeks and it has not gone down since.”</blockquote>\n        <figcaption>\n          <img src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Favatar-1.jpg&w=96&q=75\" alt=\"Portrait of Rohan Deshpande\" width=\"56\" height=\"56\">\n          <span><strong>Rohan Deshpande</strong><span class=\"muted\">Co-founder, NovaTech</span></span>\n        </figcaption>\n      </figure>\n    </div>\n  </div>\n  <style>\n    .cmp-testimonials .cmp-testimonials__head{margin-bottom:40px}\n    .cmp-testimonials .cmp-testimonials__head .h2{margin:8px 0 0}\n    .cmp-testimonials .cmp-testimonials__grid{display:grid;grid-template-columns:1fr 2fr;gap:24px}\n    .cmp-testimonials .cmp-testimonials__stats{list-style:none;padding:0;margin:0;display:grid;gap:16px}\n    .cmp-testimonials .cmp-testimonials__stats li{display:flex;align-items:center;gap:16px;padding:20px 22px}\n    .cmp-testimonials .cmp-testimonials__stats p{margin:0;font-weight:600}\n    .cmp-testimonials .cmp-testimonials__icon{display:grid;place-items:center;width:44px;height:44px;flex:none;border-radius:12px;background:color-mix(in srgb,var(--accent) 14%,transparent);color:var(--accent)}\n    .cmp-testimonials .cmp-testimonials__quote{margin:0;padding:clamp(28px,4vw,48px);display:flex;flex-direction:column;justify-content:space-between;gap:32px;position:relative;overflow:hidden}\n    .cmp-testimonials .cmp-testimonials__quote::after{content:\"“\";position:absolute;right:24px;top:-30px;font-size:14rem;line-height:1;font-family:Georgia,serif;color:var(--accent);opacity:.12;pointer-events:none}\n    .cmp-testimonials .cmp-testimonials__meta{display:flex;justify-content:space-between;align-items:center}\n    .cmp-testimonials .cmp-testimonials__stars{color:var(--accent);letter-spacing:.15em}\n    .cmp-testimonials blockquote{margin:0;font-size:clamp(1.35rem,2.6vw,2rem);line-height:1.35;letter-spacing:-.01em;font-weight:500;color:var(--fg)}\n    .cmp-testimonials figcaption{display:flex;align-items:center;gap:14px}\n    .cmp-testimonials figcaption img{width:56px;height:56px;border-radius:50%;object-fit:cover}\n    .cmp-testimonials figcaption strong{display:block}\n    .cmp-testimonials figcaption .muted{font-size:.9rem}\n    @media (max-width:860px){.cmp-testimonials .cmp-testimonials__grid{grid-template-columns:1fr}.cmp-testimonials .cmp-testimonials__quote{order:-1}}\n  </style>\n</section>","sourceUrl":"https://logicloomweb.com/","createdAt":"2026-10-17T07:15:21.668Z"}