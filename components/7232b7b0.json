{"id":"7232b7b0","type":"hero","label":"Hero: Digital marketing agency that drives real customers","html":"<section class=\"cmp cmp-hero section\" id=\"main\">\n  <div class=\"container\">\n    <div class=\"cmp-hero__grid\">\n      <div class=\"cmp-hero__copy\">\n        <span class=\"eyebrow\">Digital Marketing Agency · Since 2016</span>\n        <h1 class=\"h1\">Digital Marketing Agency That Drive <span class=\"cmp-hero__hl\">Real Customers</span> to Your Business</h1>\n        <p class=\"lead\">Grow Your Visibility, Leads, and Sales with Proven SEO Strategies</p>\n        <p class=\"muted\">We provide professional Digital Marketing Services designed to help your business rank higher in Google search, appear in local results, and attract customers ready to buy. If you’re looking for reliable Digital Marketing services near you, we deliver strategies that generate real results.</p>\n        <div class=\"cmp-hero__ctas\">\n          <a class=\"btn accent\" href=\"#contact\">Get Report</a>\n          <a class=\"btn\" href=\"#contact\">Book a Free Consultation</a>\n        </div>\n        <div class=\"cmp-hero__trust\">\n          <span class=\"muted\">Rated on</span>\n          <img src=\"https://zootwebagency.com/_next/image/?url=%2Fuploads%2F2026%2F05%2Fgoogle.png&w=1920&q=75&dpl=dpl_5T2BU7UNNuondXuXiGnhzzGeNHdu\" alt=\"Google reviews\">\n          <img src=\"https://zootwebagency.com/_next/image/?url=%2Fuploads%2F2026%2F05%2Fclutch.png&w=1920&q=75&dpl=dpl_5T2BU7UNNuondXuXiGnhzzGeNHdu\" alt=\"Clutch reviews\">\n          <img src=\"https://zootwebagency.com/_next/image/?url=%2Fuploads%2F2026%2F05%2Ftp.png&w=1200&q=75&dpl=dpl_5T2BU7UNNuondXuXiGnhzzGeNHdu\" alt=\"Trustpilot reviews\">\n        </div>\n      </div>\n      <div class=\"cmp-hero__visual\">\n        <div class=\"cmp-hero__glow\" aria-hidden=\"true\"></div>\n        <img class=\"cmp-hero__img\" src=\"https://zootwebagency.com/_next/image/?url=%2Fuploads%2F2026%2F02%2FKfASKiURLEglp2K702oWlM8EQ-removebg-preview-1.webp&w=1080&q=75&dpl=dpl_5T2BU7UNNuondXuXiGnhzzGeNHdu\" alt=\"digital marketing services\">\n        <div class=\"cmp-hero__chip card\"><strong>100%</strong><span class=\"muted\">Guaranteed Improvements</span></div>\n      </div>\n    </div>\n  </div>\n  <style>\n    .cmp-hero{position:relative;overflow:hidden}\n    .cmp-hero .cmp-hero__grid{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center}\n    .cmp-hero .cmp-hero__copy > * + *{margin-top:18px}\n    .cmp-hero .cmp-hero__hl{color:var(--accent)}\n    .cmp-hero .cmp-hero__ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}\n    .cmp-hero .cmp-hero__trust{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:32px;padding-top:24px;border-top:1px solid var(--border)}\n    .cmp-hero .cmp-hero__trust img{height:28px;width:auto;object-fit:contain}\n    .cmp-hero .cmp-hero__visual{position:relative;display:flex;justify-content:center}\n    .cmp-hero .cmp-hero__glow{position:absolute;inset:8% 8%;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 35%,transparent),transparent 70%);filter:blur(20px)}\n    .cmp-hero .cmp-hero__img{position:relative;width:100%;max-width:480px;height:auto;animation:cmpHeroFloat 6s ease-in-out infinite}\n    .cmp-hero .cmp-hero__chip{position:absolute;left:0;bottom:8%;display:flex;flex-direction:column;padding:14px 18px}\n    .cmp-hero .cmp-hero__chip strong{font-size:1.6rem;color:var(--accent)}\n    @keyframes cmpHeroFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}\n    @media (max-width:860px){.cmp-hero .cmp-hero__grid{grid-template-columns:1fr}.cmp-hero .cmp-hero__chip{position:static;margin-top:12px}}\n  </style>\n</section>","sourceUrl":"https://zootwebagency.com/","createdAt":"2026-10-17T07:19:35.275Z"}