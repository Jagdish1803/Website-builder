>\n      <a class=\"btn cmp-footer__top-btn\" href=\"#main\">Back to top ↑</a>\n    </div>\n  </div>\n  <style>\n    .cmp-footer{background:var(--surface);border-top:1px solid var(--border);overflow:hidden}\n    .cmp-footer .cmp-footer__top{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px}\n    .cmp-footer .cmp-footer__logo{font-size:1.6rem;font-weight:800;letter-spacing:.04em;color:var(--fg);text-decoration:none}\n    .cmp-footer .cmp-footer__brand p{margin:14px 0 18px;max-width:42ch}\n    .cmp-footer .cmp-footer__mail{color:var(--fg);font-weight:600;text-decoration:none;border-bottom:1px solid var(--accent)}\n    .cmp-footer .cmp-footer__col ul{list-style:none;padding:0;margin:14px 0 0;display:grid;gap:10px}\n    .cmp-footer .cmp-footer__col a{color:var(--muted);text-decoration:none;transition:color .2s}\n    .cmp-footer .cmp-footer__col a:hover{color:var(--accent)}\n    .cmp-footer .cmp-footer__word{font-size:clamp(6rem,26vw,22rem);font-weight:800;line-height:.8;letter-spacing:-.06em;text-align:center;margin:56px 0 24px;color:transparent;-webkit-text-stroke:1px var(--border);user-select:none}\n    .cmp-footer .cmp-footer__bottom{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px;padding-top:24px;border-top:1px solid var(--border)}\n    .cmp-footer .cmp-footer__bottom p{margin:0;font-size:.9rem}\n    .cmp-footer .cmp-footer__dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--accent);margin-right:8px;vertical-align:middle;animation:cmpFooterPulse 2s ease-in-out infinite}\n    @keyframes cmpFooterPulse{50%{transform:scale(1.5)}}\n    @media (max-width:860px){.cmp-footer .cmp-footer__top{grid-template-columns:1fr 1fr}.cmp-footer .cmp-footer__brand{grid-column:1/-1}}\n    @media (prefers-reduced-motion:reduce){.cmp-footer .cmp-footer__dot{animation:none}}\n  </style>\n</section>","sourceUrl":"https://logicloomweb.com/","createdAt":"2026-10-17T07:15:21.668Z"}