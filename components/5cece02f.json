{"id":"5cece02f","type":"faq","label":"Frequently asked questions","html":"<section class=\"cmp cmp-faq section\">\n  <div class=\"container\">\n    <div class=\"cmp-faq__wrap\">\n      <div class=\"cmp-faq__intro\">\n        <p class=\"eyebrow\">Questions</p>\n        <h2 class=\"h2\">Good to know before you start</h2>\n        <p class=\"muted\">Still wondering about something? Ask us anything.</p>\n        <a class=\"btn\" href=\"/contact\">Ask us anything →</a>\n      </div>\n      <ol class=\"cmp-faq__list\">\n        <li><a href=\"/faq#cost\"><span>(01)</span><h3 class=\"h3\">How much do home interiors cost?</h3><i aria-hidden=\"true\">+</i></a></li>\n        <li><a href=\"/faq#consultation\"><span>(02)</span><h3 class=\"h3\">Is the first consultation really free?</h3><i aria-hidden=\"true\">+</i></a></li>\n        <li><a href=\"/faq#timeline\"><span>(03)</span><h3 class=\"h3\">How long does a project take?</h3><i aria-hidden=\"true\">+</i></a></li>\n        <li><a href=\"/faq#areas\"><span>(04)</span><h3 class=\"h3\">Which areas do you cover?</h3><i aria-hidden=\"true\">+</i></a></li>\n        <li><a href=\"/faq#design-preview\"><span>(05)</span><h3 class=\"h3\">Can I see the design before work begins?</h3><i aria-hidden=\"true\">+</i></a></li>\n        <li><a href=\"/faq#payments\"><span>(06)</span><h3 class=\"h3\">How do payments work?</h3><i aria-hidden=\"true\">+</i></a></li>\n      </ol>\n    </div>\n  </div>\n  <style>\n    .cmp-faq .cmp-faq__wrap{display:grid;grid-template-columns:1fr 1.5fr;gap:clamp(2rem,5vw,5rem);align-items:start}\n    .cmp-faq .cmp-faq__intro{position:sticky;top:6rem}\n    .cmp-faq .cmp-faq__intro .h2{margin:.4rem 0 .75rem}\n    .cmp-faq .cmp-faq__intro .muted{margin:0 0 1.5rem}\n    .cmp-faq .cmp-faq__list{list-style:none;margin:0;padding:0;border-top:1px solid var(--border)}\n    .cmp-faq .cmp-faq__list li{border-bottom:1px solid var(--border)}\n    .cmp-faq .cmp-faq__list a{display:grid;grid-template-columns:52px 1fr 32px;align-items:center;gap:1rem;padding:1.4rem .25rem;color:var(--fg);text-decoration:none}\n    .cmp-faq .cmp-faq__list span{color:var(--muted);font-size:.82rem}\n    .cmp-faq .cmp-faq__list .h3{margin:0;font-size:clamp(1.02rem,1.6vw,1.2rem);font-weight:500;transition:color .2s}\n    .cmp-faq .cmp-faq__list i{font-style:normal;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;border:1px solid var(--border);transition:background .2s,color .2s,transform .3s}\n    .cmp-faq .cmp-faq__list a:hover .h3{color:var(--accent)}\n    .cmp-faq .cmp-faq__list a:hover i{background:var(--accent);color:var(--accent-contrast);border-color:var(--accent);transform:rotate(90deg)}\n    @media (max-width:860px){.cmp-faq .cmp-faq__wrap{grid-template-columns:1fr}.cmp-faq .cmp-faq__intro{position:static}}\n  </style>\n</section>","sourceUrl":"https://interior-site-murex.vercel.app/","createdAt":"2026-10-17T08:22:51.737Z"}