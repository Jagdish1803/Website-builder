{"id":"132dfd4a","type":"about","label":"Meet the Studio","html":"<section class=\"cmp cmp-about section\" id=\"about\">\n  <div class=\"container\">\n    <div class=\"cmp-about__grid\">\n      <div class=\"cmp-about__photo\">\n        <img src=\"https://logicloomweb.com/_next/image?url=%2Fimages%2Ffounder.jpg&w=1920&q=75\" alt=\"LLW studio founder\" loading=\"lazy\">\n        <span class=\"cmp-about__badge\">Mumbai · Shipping worldwide</span>\n      </div>\n      <div class=\"cmp-about__copy\">\n        <p class=\"eyebrow\">(Intro)</p>\n        <h2 class=\"h2\">Meet the Studio</h2>\n        <p class=\"lead\">LLW is a small studio building websites and design systems for startups and creative teams.</p>\n        <p class=\"muted\">We work the way the name reads — <strong>logic first, then craft</strong>: structure the problem, then weave the interface around it. Based in Mumbai, shipping for teams anywhere.</p>\n        <div class=\"cmp-about__steps\">\n          <div><span>01</span><strong>Logic</strong><p class=\"muted\">Structure the problem.</p></div>\n          <div><span>02</span><strong>Loom</strong><p class=\"muted\">Weave the interface around it.</p></div>\n        </div>\n        <a class=\"btn\" href=\"#contact\">Work with us →</a>\n      </div>\n    </div>\n  </div>\n  <style>\n    .cmp-about .cmp-about__grid{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(32px,6vw,80px);align-items:center}\n    .cmp-about .cmp-about__photo{position:relative;border-radius:var(--radius);overflow:hidden;aspect-ratio:4/5;border:1px solid var(--border)}\n    .cmp-about .cmp-about__photo img{width:100%;height:100%;object-fit:cover;display:block}\n    .cmp-about .cmp-about__badge{position:absolute;left:16px;bottom:16px;padding:10px 16px;border-radius:999px;background:var(--bg);color:var(--fg);font-size:.88rem;font-weight:600;border:1px solid var(--border)}\n    .cmp-about .cmp-about__copy .h2{margin:8px 0 20px}\n    .cmp-about .cmp-about__copy .lead{margin:0 0 16px}\n    .cmp-about .cmp-about__copy strong{color:var(--fg)}\n    .cmp-about .cmp-about__steps{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:28px 0}\n    .cmp-about .cmp-about__steps div{padding:20px;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--surface)}\n    .cmp-about .cmp-about__steps span{display:block;font-family:ui-monospace,Menlo,monospace;color:var(--accent);font-size:.8rem;margin-bottom:8px}\n    .cmp-about .cmp-about__steps p{margin:4px 0 0;font-size:.92rem}\n    @media (max-width:860px){.cmp-about .cmp-about__grid{grid-template-columns:1fr}.cmp-about .cmp-about__photo{aspect-ratio:4/3}}\n  </style>\n</section>","sourceUrl":"https://logicloomweb.com/","createdAt":"2026-10-17T07:15:21.668Z"}