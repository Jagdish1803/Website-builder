{"id":"8a9d8aa1","type":"fiverr","label":"Hire us on Fiverr","html":"<section class=\"cmp cmp-fiverr section\" id=\"fiverr\">\n  <div class=\"container\">\n    <div class=\"cmp-fiverr__grid\">\n      <div class=\"cmp-fiverr__intro\">\n        <p class=\"eyebrow\">(Also on Fiverr)</p>\n        <h2 class=\"h2\">Hire Us on Fiverr</h2>\n        <p class=\"lead muted\">Prefer a marketplace? The same team, the same code — booked as a single fixed-price gig, with Fiverr holding the payment until you approve the work.</p>\n        <a class=\"btn\" href=\"https://www.fiverr.com/\">View Fiverr Profile ↗</a>\n      </div>\n      <div class=\"cmp-fiverr__gigs\">\n        <a class=\"card cmp-fiverr__gig\" href=\"https://www.fiverr.com/\">\n          <span class=\"tag\">Gig · Build</span>\n          <h3 class=\"h3\">I will design and develop a responsive business website</h3>\n          <p class=\"muted\">A complete website built from scratch — design, build, mobile-responsive, connected to your domain and live.</p>\n          <dl>\n            <div><dt>Delivery</dt><dd>5 days</dd></div>\n            <div><dt>Starting at</dt><dd class=\"cmp-fiverr__price\">$45</dd></div>\n          </dl>\n        </a>\n        <a class=\"card cmp-fiverr__gig\" href=\"https://www.fiverr.com/\">\n          <span class=\"tag\">Gig · Fix</span>\n          <h3 class=\"h3\">I will fix any website bug, error or broken layout</h3>\n          <p class=\"muted\">Broken pages, plugin conflicts, PHP or JavaScript errors, layouts that fall apart on mobile — diagnosed and fixed.</p>\n          <dl>\n            <div><dt>Delivery</dt><dd>1 day</dd></div>\n            <div><dt>Starting at</dt><dd class=\"cmp-fiverr__price\">$15</dd></div>\n          </dl>\n        </a>\n      </div>\n    </div>\n  </div>\n  <style>\n    .cmp-fiverr .cmp-fiverr__grid{display:grid;grid-template-columns:1fr 1.4fr;gap:clamp(32px,5vw,64px);align-items:start}\n    .cmp-fiverr .cmp-fiverr__intro{position:sticky;top:110px}\n    .cmp-fiverr .cmp-fiverr__intro .h2{margin:8px 0 16px}\n    .cmp-fiverr .cmp-fiverr__intro .lead{margin:0 0 28px}\n    .cmp-fiverr .cmp-fiverr__gigs{display:grid;gap:20px}\n    .cmp-fiverr .cmp-fiverr__gig{display:flex;flex-direction:column;gap:12px;padding:28px;text-decoration:none;color:inherit;transition:border-color .25s,transform .25s}\n    .cmp-fiverr .cmp-fiverr__gig:hover{border-color:var(--accent);transform:translateY(-3px)}\n    .cmp-fiverr .cmp-fiverr__gig .tag{align-self:flex-start}\n    .cmp-fiverr .cmp-fiverr__gig .h3,.cmp-fiverr .cmp-fiverr__gig p{margin:0}\n    .cmp-fiverr .cmp-fiverr__gig dl{display:flex;justify-content:space-between;align-items:end;margin:8px 0 0;padding-top:16px;border-top:1px solid var(--border)}\n    .cmp-fiverr .cmp-fiverr__gig dt{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}\n    .cmp-fiverr .cmp-fiverr__gig dd{margin:4px 0 0;font-weight:600}\n    .cmp-fiverr .cmp-fiverr__gig dl div:last-child{text-align:right}\n    .cmp-fiverr .cmp-fiverr__price{font-size:2rem;letter-spacing:-.03em;color:var(--accent)}\n    @media (max-width:860px){.cmp-fiverr .cmp-fiverr__grid{grid-template-columns:1fr}.cmp-fiverr .cmp-fiverr__intro{position:static}}\n  </style>\n</section>","sourceUrl":"https://logicloomweb.com/","createdAt":"2026-10-17T07:15:21.668Z"}