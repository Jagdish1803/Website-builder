{"id":"0334bab4","type":"services","label":"Our services list","html":"<section class=\"cmp cmp-services section\">\n  <div class=\"container\">\n    <div class=\"cmp-services__head\">\n      <p class=\"eyebrow\">Our services</p>\n      <h2 class=\"h2\">Build a home that lasts</h2>\n    </div>\n    <ol class=\"cmp-services__list\">\n      <li><a href=\"/services/home-interiors\"><span class=\"cmp-services__num\">(01)</span><h3 class=\"h3\">Home interiors</h3><p class=\"muted\">Complete interiors for apartments, villas and independent houses, from a single room refresh to a full home.</p><span class=\"cmp-services__arrow\" aria-hidden=\"true\">↗</span></a></li>\n      <li><a href=\"/services/office-interiors\"><span class=\"cmp-services__num\">(02)</span><h3 class=\"h3\">Office interiors</h3><p class=\"muted\">Workspaces that help teams focus and collaborate, delivered with minimal disruption to your business.</p><span class=\"cmp-services__arrow\" aria-hidden=\"true\">↗</span></a></li>\n      <li><a href=\"/services/commercial-interiors\"><span class=\"cmp-services__num\">(03)</span><h3 class=\"h3\">Commercial interiors</h3><p class=\"muted\">Retail stores, cafés, showrooms and hospitality spaces designed to draw people in and keep them coming back.</p><span class=\"cmp-services__arrow\" aria-hidden=\"true\">↗</span></a></li>\n      <li><a href=\"/services/made-to-measure\"><span class=\"cmp-services__num\">(04)</span><h3 class=\"h3\">Made-to-measure finishes</h3><p class=\"muted\">Blinds, flooring, invisible grills, awnings and mosquito nets, measured and installed by our own team.</p><span class=\"cmp-services__arrow\" aria-hidden=\"true\">↗</span></a></li>\n      <li><a href=\"/designs\"><span class=\"cmp-services__num\">(05)</span><h3 class=\"h3\">Ready designs</h3><p class=\"muted\">Complete room designs with a budget and the exact products used. Pick one and we adapt it to your space.</p><span class=\"cmp-services__arrow\" aria-hidden=\"true\">↗</span></a></li>\n    </ol>\n  </div>\n  <style>\n    .cmp-services .cmp-services__head{display:flex;justify-content:space-between;align-items:end;gap:1rem;flex-wrap:wrap;margin-bottom:2.5rem}\n    .cmp-services .cmp-services__head .h2{margin:.4rem 0 0}\n    .cmp-services .cmp-services__list{list-style:none;margin:0;padding:0;border-top:1px solid var(--border)}\n    .cmp-services .cmp-services__list li{border-bottom:1px solid var(--border)}\n    .cmp-services .cmp-services__list a{display:grid;grid-template-columns:80px minmax(200px,1fr) 1.3fr 40px;gap:1.5rem;align-items:baseline;padding:1.75rem .5rem;color:inherit;text-decoration:none;transition:background .25s,padding .25s;border-radius:var(--radius-sm)}\n    .cmp-services .cmp-services__list a:hover{background:var(--surface);padding-left:1.25rem}\n    .cmp-services .cmp-services__num{font-size:.85rem;color:var(--muted);font-variant-numeric:tabular-nums}\n    .cmp-services .h3{margin:0}\n    .cmp-services .muted{margin:0;max-width:52ch}\n    .cmp-services .cmp-services__arrow{font-size:1.3rem;color:var(--accent);justify-self:end;transition:transform .25s}\n    .cmp-services .cmp-services__list a:hover .cmp-services__arrow{transform:translate(3px,-3px)}\n    @media (max-width:760px){\n      .cmp-services .cmp-services__list a{grid-template-columns:48px 1fr 24px;gap:.5rem 1rem}\n      .cmp-services .cmp-services__list .muted{grid-column:2/3;grid-row:2}\n      .cmp-services .cmp-services__arrow{grid-column:3;grid-row:1}\n    }\n  </style>\n</section>","sourceUrl":"https://interior-site-murex.vercel.app/","createdAt":"2026-10-17T08:22:51.737Z"}