{"id":"f7ee0851","type":"cta","label":"Book a consultation call to action","html":"<section class=\"cmp cmp-cta section\">\n  <div class=\"container\">\n    <div class=\"cmp-cta__panel\">\n      <img class=\"cmp-cta__bg\" src=\"https://interior-site-murex.vercel.app/_next/image?url=%2Fimages%2Fdesigns%2Ftwo-tone-modular-kitchen.jpg&w=3840&q=75\" alt=\"\" loading=\"lazy\">\n      <div class=\"cmp-cta__inner\">\n        <p class=\"eyebrow\">Begin your project with INTERIORSTUDIO</p>\n        <p class=\"cmp-cta__title\">Let’s design a space you’ll love coming home to.</p>\n        <p class=\"lead\">Meet an architect online or at your site. The first consultation is free.</p>\n        <div class=\"cmp-cta__btns\">\n          <a class=\"btn accent\" href=\"/contact\">Book a free consultation</a>\n          <a class=\"btn cmp-cta__ghost\" href=\"/estimate\">Get an instant estimate</a>\n          <a class=\"cmp-cta__link\" href=\"/contact\">Get in touch →</a>\n        </div>\n      </div>\n    </div>\n  </div>\n  <style>\n    .cmp-cta .cmp-cta__panel{position:relative;border-radius:var(--radius);overflow:hidden;isolation:isolate;padding:clamp(2.5rem,7vw,6rem) clamp(1.5rem,5vw,4rem);color:#fff}\n    .cmp-cta .cmp-cta__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}\n    .cmp-cta .cmp-cta__panel::before{content:\"\";position:absolute;inset:0;z-index:-1;background:linear-gradient(100deg,rgba(0,0,0,.78) 0%,rgba(0,0,0,.45) 60%,rgba(0,0,0,.2) 100%)}\n    .cmp-cta .cmp-cta__inner{max-width:640px}\n    .cmp-cta .eyebrow{color:rgba(255,255,255,.75)}\n    .cmp-cta .cmp-cta__title{font-size:clamp(2rem,4.5vw,3.4rem);line-height:1.08;letter-spacing:-.02em;margin:.6rem 0 1rem;font-weight:600}\n    .cmp-cta .lead{color:rgba(255,255,255,.85);margin:0 0 2rem}\n    .cmp-cta .cmp-cta__btns{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem 1rem}\n    .cmp-cta .cmp-cta__ghost{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.45)}\n    .cmp-cta .cmp-cta__ghost:hover{background:rgba(255,255,255,.2)}\n    .cmp-cta .cmp-cta__link{color:#fff;text-decoration:underline;text-underline-offset:4px;font-size:.95rem}\n  </style>\n</section>","sourceUrl":"https://interior-site-murex.vercel.app/","createdAt":"2026-10-17T08:22:51.737Z"}