{"id":"16ab6bb8","type":"features","label":"Why choose us","html":"<section class=\"cmp cmp-features section\">\n  <div class=\"container\">\n    <div class=\"cmp-features__head\">\n      <p class=\"eyebrow\">Why choose us</p>\n      <h2 class=\"h2\">Elevating the art of living, without the asterisks</h2>\n    </div>\n    <ol class=\"cmp-features__grid\">\n      <li><a class=\"card\" href=\"/estimate\"><span class=\"cmp-features__num\">01</span><h3 class=\"h3\">Prices without an OTP</h3><p class=\"muted\">A realistic estimate in under a minute. No phone number, no OTP, no sales call.</p></a></li>\n      <li><a class=\"card\" href=\"/designs\"><span class=\"cmp-features__num\">02</span><h3 class=\"h3\">A budget on every design</h3><p class=\"muted\">Every ready design shows a price range and the exact products used.</p></a></li>\n      <li><a class=\"card\" href=\"/contact\"><span class=\"cmp-features__num\">03</span><h3 class=\"h3\">Book a slot yourself</h3><p class=\"muted\">Pick a time online or at your site. No waiting for a callback.</p></a></li>\n      <li><a class=\"card\" href=\"/shop\"><span class=\"cmp-features__num\">04</span><h3 class=\"h3\">Preview it in your room</h3><p class=\"muted\">Place products with AR on your phone, or try finishes on a photo of your wall.</p></a></li>\n      <li><a class=\"card\" href=\"/shop\"><span class=\"cmp-features__num\">05</span><h3 class=\"h3\">Shop finishes online</h3><p class=\"muted\">Blinds, flooring, wallpapers, paints and more, delivered or installed by us.</p></a></li>\n      <li><a class=\"card\" href=\"/account\"><span class=\"cmp-features__num\">06</span><h3 class=\"h3\">Accept quotes online</h3><p class=\"muted\">Itemised quotes you can approve and pay for securely, in minutes.</p></a></li>\n      <li><a class=\"card\" href=\"/materials\"><span class=\"cmp-features__num\">07</span><h3 class=\"h3\">Materials, explained</h3><p class=\"muted\">Board grades, finishes and hardware in plain words, with care tips.</p></a></li>\n      <li><a class=\"card\" href=\"/account\"><span class=\"cmp-features__num\">08</span><h3 class=\"h3\">Track everything</h3><p class=\"muted\">Orders, quotes, bookings and saved designs, all in one account.</p></a></li>\n    </ol>\n  </div>\n  <style>\n    .cmp-features{background:var(--surface)}\n    .cmp-features .cmp-features__head{max-width:720px;margin-bottom:2.5rem}\n    .cmp-features .cmp-features__head .h2{margin:.4rem 0 0}\n    .cmp-features .cmp-features__grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}\n    .cmp-features .card{display:flex;flex-direction:column;height:100%;color:var(--fg);text-decoration:none;background:var(--bg);transition:transform .25s,border-color .25s}\n    .cmp-features .card:hover{transform:translateY(-4px);border-color:var(--accent)}\n    .cmp-features .cmp-features__num{display:inline-grid;place-items:center;width:2.4rem;height:2.4rem;border-radius:50%;border:1px solid var(--border);font-size:.8rem;color:var(--accent);font-weight:600;margin-bottom:1.5rem}\n    .cmp-features .h3{margin:0 0 .5rem;font-size:1.1rem}\n    .cmp-features .muted{margin:0;font-size:.95rem}\n    @media (max-width:1000px){.cmp-features .cmp-features__grid{grid-template-columns:repeat(2,1fr)}}\n    @media (max-width:520px){.cmp-features .cmp-features__grid{grid-template-columns:1fr}}\n  </style>\n</section>","sourceUrl":"https://interior-site-murex.vercel.app/","createdAt":"2026-10-17T08:22:51.737Z"}