{"id":"9495e124","type":"cta","label":"Transform your brand call to action","html":"<section class=\"cmp cmp-cta section\">\n  <div class=\"container\">\n    <div class=\"cmp-cta__box\">\n      <h2 class=\"h2\">Transform Your Brand Into a Growth Engine</h2>\n      <p class=\"lead\">We help businesses generate real leads, measurable growth, and lasting impact through performance driven digital marketing strategies.</p>\n      <div class=\"cmp-cta__actions\">\n        <a class=\"btn cmp-cta__btn\" href=\"#contact\">Let's Discuss a project</a>\n        <a class=\"btn cmp-cta__ghost\" href=\"#contact\">Get Report</a>\n      </div>\n    </div>\n  </div>\n  <style>\n    .cmp-cta .cmp-cta__box{text-align:center;padding:clamp(40px,7vw,88px) clamp(24px,5vw,64px);border-radius:var(--radius);background:radial-gradient(80% 120% at 0% 0%,rgba(255,255,255,.18),transparent 55%),var(--accent);color:var(--accent-contrast)}\n    .cmp-cta .cmp-cta__box .h2{color:inherit;max-width:760px;margin:0 auto}\n    .cmp-cta .cmp-cta__box .lead{color:inherit;opacity:.9;max-width:620px;margin:16px auto 0}\n    .cmp-cta .cmp-cta__actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:32px}\n    .cmp-cta .cmp-cta__btn{background:var(--accent-contrast);color:var(--accent);border-color:var(--accent-contrast)}\n    .cmp-cta .cmp-cta__ghost{background:transparent;color:var(--accent-contrast);border-color:currentColor}\n  </style>\n</section>","sourceUrl":"https://zootwebagency.com/","createdAt":"2026-10-17T07:19:35.275Z"}